{
  "name": "natives",
  "version": "0.1.0",
  "description": "AI Steam Base — Tauri Desktop Application Container",
  "private": true,
  "scripts": {
    "web:dev": "NODE_ENV=development next dev -H 127.0.0.1 -p 3000",
    "daemon:build": "cargo build -p natives-agent-daemon",
    "daemon:bundle": "bash scripts/daemon/prepare-sidecar.sh",
    "dev": "npm run daemon:build && tauri dev",
    "build": "next build",
    "perf:bundle": "node scripts/perf/check-bundle.mjs",
    "perf:check": "npm run typecheck && npm run lint && npm run build && npm run perf:bundle",
    "start": "next start",
    "lint": "eslint src/ && node scripts/i18n-check.mjs && node scripts/check-hardcoded-colors.mjs",
    "colors:check": "node scripts/check-hardcoded-colors.mjs",
    "test": "find src \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print0 | xargs -0 tsx --import ./scripts/test-css-stub.cjs --test",
    "typecheck": "tsc --noEmit",
    "protocol:check": "node scripts/check-protocol-sync.mjs",
    "types:generate": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "verify:native-engine": "bash scripts/daemon/verify-native-engine.sh",
    "i18n:check": "node scripts/i18n-check.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run dev",
    "tauri:build": "npm run daemon:bundle && tauri build --config src-tauri/tauri.bundle.conf.json",
    "test:linkage": "node scripts/assistant-linkage-evidence.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.2",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "@uiw/react-md-editor": "^4.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.5.17",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "i18next": "^26.3.1",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "recharts": "^3.8.1",
    "shiki": "^4.2.0",
    "three": "^0.184.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.9",
    "@next/swc-darwin-arm64": "^16.2.9",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1"
  }
}
