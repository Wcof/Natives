{
  "manifest_version": 3,
  "name": "Natives 文件管理",
  "version": "0.1.0",
  "description": "在 Chrome 中安全访问本机文件管理器",
  "default_locale": "zh_CN",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "chrome_url_overrides": { "newtab": "space.html" },
  "action": {
    "default_title": "文件管理",
    "default_icon": {
      "16": "icons/folder-16.png",
      "32": "icons/folder-32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/folder-16.png", "32": "icons/folder-32.png", "128": "icons/folder-128.png" }
}
