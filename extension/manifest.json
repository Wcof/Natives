{
  "manifest_version": 3,
  "name": "Natives 文件管理",
  "version": "0.1.0",
  "description": "在 Chrome 中安全访问本机文件管理器",
  "default_locale": "zh_CN",
  "permissions": ["nativeMessaging", "storage", "tabs", "activeTab", "scripting", "contextMenus"],
  "optional_permissions": ["bookmarks", "topSites"],
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_captureCommandDescription__"
    }
  },
  "host_permissions": [
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*",
    "https://releases.githubusercontent.com/*",
    "https://ghproxy.net/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.bing.com/*",
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://api.nasa.gov/*",
    "https://apod.nasa.gov/*",
    "https://api.wikimedia.org/*",
    "https://upload.wikimedia.org/*",
    "https://api.giphy.com/*",
    "https://open.er-api.com/*",
    "https://api.ipify.org/*",
    "https://github-contributions-api.jogruber.de/*",
    "https://i.pravatar.cc/*",
    "https://api.coingecko.com/*",
    "https://www.google.com/*",
    "https://duckduckgo.com/*",
    "https://en.wikipedia.org/*"
  ],
  "chrome_url_overrides": { "newtab": "space.html" },
  "action": {
    "default_title": "文件管理",
    "default_icon": {
      "16": "icons/folder-16.png",
      "32": "icons/folder-32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["content-file-handler.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": { "16": "icons/folder-16.png", "32": "icons/folder-32.png", "128": "icons/folder-128.png" }
}
